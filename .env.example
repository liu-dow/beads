SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Required on a deployed site; omit locally to use the current localhost port.
APP_ORIGIN=https://your-site.example
# Keep both switches enabled until account sign-in is intentionally launched.
NEXT_PUBLIC_GUEST_ONLY=true
GUEST_ONLY=true
# Enable only after the Google provider and redirect URLs are configured.
GOOGLE_AUTH_ENABLED=false
